{
  "manifest_version": 3,
  "name": "evas — bookmarks conectados",
  "version": "0.1.0",
  "description": "Importe, organize e conecte seus favoritos em uma biblioteca visual e um grafo pessoal.",
  "permissions": ["storage"],
  "optional_permissions": ["bookmarks"],
  "action": {"default_title": "Abrir evas", "default_icon": "assets/icon.png"},
  "icons": {"128": "assets/icon.png"},
  "background": {"service_worker": "src/background.js"},
  "options_page": "index.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
